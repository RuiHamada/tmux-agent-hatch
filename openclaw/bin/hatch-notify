#!/usr/bin/env bash
# Called from Claude Code / Codex hooks; POSTs a short notice to OpenClaw's /hooks/wake.
# Does nothing without the config file (~/.openclaw/hatch-notify.env). Always exits 0 so the hook never blocks.
#
# How the source pane is found. TMUX_PANE may be stale under Codex's app-server daemon, so it is the
# last resort.
#   1. walk up the parent processes to a claude / codex process and take the pane owning its tty
#   2. (codex) the sessionId in hatch-status/<pid>.json written by hooks/codex/status.sh -> pid -> tty -> pane
#   3. a pane running claude / codex in the payload's cwd (several candidates: list them in the notice)
#   4. TMUX_PANE, if that pane still exists
# Targets are "claude / codex running inside a tmux pane" (the same rule as hatch-list), not session names.
#
# What was sent or skipped, and the HTTP status, go to ~/.openclaw/hatch-notify.log (never the token or the body).
set -uo pipefail
env_file="${HATCH_NOTIFY_ENV:-$HOME/.openclaw/hatch-notify.env}"
[ -r "$env_file" ] || exit 0
# shellcheck disable=SC1090
. "$env_file"
LOG="${OPENCLAW_HATCH_LOG:-${env_file%/*}/hatch-notify.log}"
log() { printf '%s [%s] %s\n' "$(date '+%F %T')" "$$" "$*" >>"$LOG" 2>/dev/null; return 0; }
# Keep the log small: above 256KB keep only the last 500 lines
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
  tail -n 500 "$LOG" >"$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
fi
if [ -z "${OPENCLAW_HOOK_URL:-}" ] || [ -z "${OPENCLAW_HOOK_TOKEN:-}" ]; then
  log "skip reason=env-incomplete (OPENCLAW_HOOK_URL / OPENCLAW_HOOK_TOKEN)"; exit 0
fi

input="$(cat 2>/dev/null)"
event="$(printf '%s' "$input" | jq -r '.hook_event_name // empty' 2>/dev/null)"
cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)"
sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)"
case "$event" in
Stop)              what="turn finished (idle)" ;;
Notification)      what="waiting: permission prompt" ;;
PreToolUse)        what="waiting: question for you" ;;
PermissionRequest) what="waiting: permission prompt" ;;
SessionEnd)        what="session ended" ;;
'')                log "skip reason=no-event"; exit 0 ;;
*)                 exit 0 ;;   # not a notified event (should not be registered); nothing to log
esac

agent_kind() {   # <pid> -> claude | codex | empty
  local c; c="$(ps -o comm= -p "$1" 2>/dev/null)"
  case "${c##*/}" in claude*) echo claude ;; codex*) echo codex ;; esac
}
tty_of() {       # <pid> -> "ttys003" / "pts/3", empty if none
  local t; t="$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ')"
  case "$t" in '' | '?' | '??') ;; *) printf '%s' "$t" ;; esac
}
pane_by_tty() {  # <tty> → pane_id
  tmux list-panes -a -F '#{pane_tty} #{pane_id}' 2>/dev/null | awk -v t="$1" '{ sub(/^\/dev\//, "", $1); if ($1 == t) { print $2; exit } }'
}
canon() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }
pane_alive() { [ -n "$1" ] && tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx -- "$1"; }  # display-message exits 0 even for a missing pane

# 1. the agent from the parent chain (hooks run via bash/sh -c, so walk a few levels)
apid=""; agent=""; pid="$PPID"
for _ in 1 2 3 4 5 6; do
  [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null || break
  agent="$(agent_kind "$pid")"
  if [ -n "$agent" ]; then apid="$pid"; break; fi
  pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
done
pane=""; by=""; candidates=""
if [ -n "$apid" ]; then
  t="$(tty_of "$apid")"
  [ -n "$t" ] && pane="$(pane_by_tty "$t")" && [ -n "$pane" ] && by="chain-tty"
fi
# 2. codex: the pid status.sh already resolved (looked up by sessionId)
if [ -z "$pane" ] && [ -n "$sid" ]; then
  for f in "${CODEX_HOME:-$HOME/.codex}"/hatch-status/*.json; do
    [ -f "$f" ] || continue
    [ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" = "$sid" ] || continue
    spid="${f##*/}"; spid="${spid%.json}"
    t="$(tty_of "$spid")"
    [ -n "$t" ] && pane="$(pane_by_tty "$t")" && [ -n "$pane" ] && { by="status-file"; agent="${agent:-codex}"; break; }
  done
fi
# 3. a pane running claude/codex whose cwd matches
if [ -z "$pane" ] && [ -n "$cwd" ]; then
  want="$(canon "$cwd")"
  while read -r ppid_ pane_ path_; do
    [ -n "$pane_" ] || continue
    [ "$(canon "$path_")" = "$want" ] || continue
    k="$(agent_kind "$ppid_")"
    if [ -z "$k" ]; then
      for c in $(pgrep -P "$ppid_" 2>/dev/null); do k="$(agent_kind "$c")"; [ -n "$k" ] && break; done
    fi
    [ -n "$k" ] || continue
    [ -n "$agent" ] && [ "$k" != "$agent" ] && continue
    candidates="${candidates:+$candidates,}$pane_"; agent="${agent:-$k}"
  done <<EOF_PANES
$(tmux list-panes -a -F '#{pane_pid} #{pane_id} #{pane_current_path}' 2>/dev/null)
EOF_PANES
  case "$candidates" in
  '') ;;
  *,*) by="cwd-ambiguous" ;;
  *) pane="$candidates"; candidates=""; by="cwd" ;;
  esac
fi
# 4. last resort: TMUX_PANE
if [ -z "$pane" ] && [ -z "$candidates" ] && pane_alive "${TMUX_PANE:-}"; then
  pane="$TMUX_PANE"; by="TMUX_PANE"
fi

if [ -n "$pane" ]; then
  session="$(tmux display-message -p -t "$pane" '#S' 2>/dev/null)"
  if [ -z "$agent" ]; then
    case "$session" in claude-*) agent=claude ;; codex-*) agent=codex ;; *) agent=agent ;; esac
  fi
  where="$session"
elif [ -n "$candidates" ]; then
  # Do not pick among candidates; list the session names and let OpenClaw check
  session=""
  for p in ${candidates//,/ }; do
    s="$(tmux display-message -p -t "$p" '#S' 2>/dev/null)"; session="${session:+$session,}$s"
  done
  where="one of [$session]"
else
  log "skip reason=no-pane event=$event agent=${agent:-?} apid=${apid:-none} tmux_pane=${TMUX_PANE:-} cwd=${cwd:-?}"
  exit 0
fi
log "resolve event=$event agent=$agent session=$session by=$by apid=${apid:-none} tmux_pane=${TMUX_PANE:-}"

hostflag="${OPENCLAW_HATCH_HOST:+ $OPENCLAW_HATCH_HOST}"
# For sessions started by hatch-launch, add whether report.md exists
rep=""
if [ -n "$pane" ]; then
  if [ "$(tmux show-options -t "$pane" -qv @hatch_ending 2>/dev/null)" = 1 ]; then
    log "skip reason=ending session=$session event=$event"; exit 0   # hatch-end is shutting this session down
  fi
  outdir="$(tmux show-options -t "$pane" -qv @hatch_out 2>/dev/null)"
  if [ -n "$outdir" ]; then
    # Keep the agent's own session id so the conversation can be resumed after the tmux session is ended.
    if [ -n "$sid" ] && [ -f "$outdir/meta.json" ]; then
      jq --arg sid "$sid" --arg tp "$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)" \
        '.agent_session_id = $sid | (if $tp != "" then .transcript_path = $tp else . end)' "$outdir/meta.json" >"$outdir/meta.json.tmp" 2>/dev/null \
        && mv -f "$outdir/meta.json.tmp" "$outdir/meta.json"
    fi
    slug="$(tmux show-options -t "$pane" -qv @hatch_slug 2>/dev/null)"
    # Without a report.md, save the final response (read-only sessions cannot write files, so this is their deliverable)
    if [ ! -f "$outdir/report.md" ] && { [ "$event" = Stop ] || [ "$event" = SessionEnd ]; }; then
      last="$(printf '%s' "$input" | jq -r '.last_assistant_message // empty' 2>/dev/null)"
      if [ -z "$last" ]; then
        tp="$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)"
        [ -r "$tp" ] && last="$(jq -r 'select(.type=="assistant") | .message.content | if type=="array" then map(select(.type=="text")|.text)|join("\n") else . end' "$tp" 2>/dev/null | awk 'NF{buf=buf $0 "\n"} /^$/{ } END{printf "%s", buf}' | tail -c 20000)"
      fi
      if [ -n "$last" ]; then
        { printf '# auto-captured final response (%s, %s)\n\n' "$session" "$(date '+%F %T')"; printf '%s\n' "$last"; } >"$outdir/report.md" 2>/dev/null \
          && log "report auto-captured session=$session bytes=${#last}"
      fi
    fi
    if [ -f "$outdir/report.md" ]; then rep=" slug=$slug report=READY (hatch-report$hostflag $session)"
    else rep=" slug=$slug report=MISSING (ask the agent to write $outdir/report.md, or read hatch-capture$hostflag $session)"; fi
  fi
fi
if [ -n "$rep" ]; then
  text="[hatch] $agent $where on $(hostname -s): $what.$rep cwd=${cwd:-?}."
else
  text="[hatch] $agent $where on $(hostname -s): $what. cwd=${cwd:-?}. Use hatch-capture$hostflag <session> to read the screen."
  case "$where" in "one of"*) ;; *) text="${text/<session>/$session}" ;; esac
fi
body="$(jq -cn --arg t "$text" --arg a "${OPENCLAW_AGENT_ID:-main}" '{text:$t, mode:"now", agentId:$a}')"
url="${OPENCLAW_HOOK_URL%/}/wake"
# Send in the background so the hook is not delayed; log only the outcome (never the token or the body).
(
  code="$(curl -sS -m 10 -o /dev/null -w '%{http_code}' -X POST "$url" \
    -H "Authorization: Bearer $OPENCLAW_HOOK_TOKEN" -H 'Content-Type: application/json' \
    --data "$body" 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 0 ] && [ "$code" -ge 200 ] 2>/dev/null && [ "$code" -lt 300 ]; then
    log "sent event=$event session=$session http=$code"
  else
    log "send-failed event=$event session=$session http=${code:-000} curl_exit=$rc url=$url"
  fi
) >/dev/null 2>&1 &
exit 0
