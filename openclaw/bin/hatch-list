#!/usr/bin/env bash
# List the agents hatch knows about as TSV (same data source as the picker).
#   agent  status  age  location  path  session
# status: waiting (needs input) / idle (done, your turn) / busy (working) / ? (unknown)
set -uo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_remote.sh"
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../scripts" && pwd)"
printf 'agent\tstatus\tage\tlocation\tpath\tsession\tslug\tmode\n'
"$DIR/agents.sh" 2>/dev/null | sed $'s/\x1b\\[[0-9;]*m//g' |
  awk -F'\t' '{
    status = $6; sub(/^● */, "", status); gsub(/ +$/, "", status)
    age = $7; gsub(/^ +| +$/, "", age)
    loc = $8; sess = loc; sub(/:.*/, "", sess)
    printf "%s\t%s\t%s\t%s\t%s\t%s\t", $5, status, age, loc, $9, sess
    cmd = "tmux show-options -t \"" sess "\" -qv @hatch_slug 2>/dev/null"; slug = ""; cmd | getline slug; close(cmd)
    cmd = "tmux show-options -t \"" sess "\" -qv @hatch_mode 2>/dev/null"; mode = ""; cmd | getline mode; close(cmd)
    print (slug == "" ? "-" : slug) "\t" (mode == "" ? "-" : mode)
  }'
