#!/usr/bin/env bash
# Start (or continue) a hatch session from OpenClaw, one task per session (no popup).
#   hatch-launch [--host <ssh-host>] [--slug <slug>] [--expect "<what the report must show>"] [--readonly]
#                [--model <name>] [--effort <level>] [--worktree] [--branch <name>] [--reuse] [--force]
#                <claude|codex> <dir> "<instructions>"
#   hatch-launch --continue <session|slug> [--expect "..."] [--model <name>] [--effort <level>] "<instructions>"
#
#   --slug     task identifier (derived from the instructions if omitted); keys the session name, out dir and ledger
#   --expect   what this task (or round) must prove, kept in the ledger (defaults to the start of the instructions)
#   --readonly investigation / review: Claude runs with --permission-mode plan, Codex with --sandbox read-only, so the CLI
#              itself guarantees nothing is written. Any number may share a dir
#   (default)  implementation (a writer). Refused if another writer is alive in the same dir (one writer per
#              working tree): separate with --worktree, continue that session with --continue, or --force
#   --model, --effort  per-launch model and reasoning effort: `codex -m <name> -c model_reasoning_effort=<level>`,
#              `claude --model <name> --effort <level>`. Nothing global is touched, so overlapping launches and the
#              user's own popups are unaffected. Recorded in meta.json, the ledger and hatch-list
#   --continue give a follow-up round to an existing task, in the same agent conversation (fix rounds keep their
#              design context). Session alive: the instructions are sent to it. Session ended: a new tmux session
#              with the same name resumes the saved agent conversation (`claude --resume <id>` / `codex resume <id>`)
#              in the same directory. Either way a new ledger round is opened and the round writes its own report
#              (report-<N>.md; earlier reports are kept). The host is taken from the ledger
#   --reuse    if hatch's own popup session for the dir exists (<prefix><hash of dir>), send the instructions there
#   --any-dir  allow launching outside a git repository (by default, outside a repository or in a parent of several is refused)
#   --worktree create (or reuse) a git worktree and launch there, in the same place as hatch's prefix+W:
#              @hatch_worktree_dir/<branch>, defaulting to <repo>-wt/<branch> next to the repository.
#              The branch is the slug unless --branch <name> is given (--branch implies --worktree).
#              Only when the user asks for a worktree
#   --no-ledger, --out, --round   internal: the remote side of --host / --continue (the ledger lives on the calling Mac)
# The agent is told to write its report when done.
#   out = ~/.agents/out/<YYYYmmdd-HHMMSS>-<slug>/ on the host the agent runs on; meta.json holds the launch info
# Output: "session=<name> state=<created|reused|continued|resumed> slug=<slug> round=<N> mode=<write|read> out=<dir> host=<host>"
# Ledger: one row per round appended to ~/.openclaw/hatch-ledger.tsv on the Mac (see hatch-ledger list)
set -uo pipefail
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
HATCH_NO_DISPATCH=1 . "$here/_remote.sh"
usage() { echo "usage: hatch-launch [--host H] [--slug S] [--expect E] [--readonly] [--model M] [--effort L] [--worktree] [--reuse] [--force] <claude|codex> <dir> \"<instructions>\"
       hatch-launch --continue <session|slug> [--expect E] [--model M] [--effort L] \"<instructions>\"" >&2; exit 2; }

host="${HATCH_HOST:-}"; slug=""; expect=""; reuse=""; worktree=""; noledger=""; readonly=""; force=""; anydir=""; branch=""
cont=""; model=""; effort=""; out=""; round=1
while [ $# -gt 0 ]; do
  case "$1" in
  --host) host="$2"; shift 2 ;;
  --slug) slug="$2"; shift 2 ;;
  --expect) expect="$2"; shift 2 ;;
  --reuse) reuse=1; shift ;;
  --worktree) worktree=1; shift ;;
  --branch) branch="$2"; worktree=1; shift 2 ;;
  --readonly) readonly=1; shift ;;
  --force) force=1; shift ;;
  --any-dir) anydir=1; shift ;;
  --continue) cont="$2"; shift 2 ;;
  --model) model="$2"; shift 2 ;;
  --effort) effort="$2"; shift 2 ;;
  --no-ledger) noledger=1; shift ;;
  --out) out="$2"; shift 2 ;;
  --round) round="$2"; shift 2 ;;
  --) shift; break ;;
  -*) echo "unknown option: $1" >&2; exit 2 ;;
  *) break ;;
  esac
done
sanitize() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/^-*//; s/-*$//; s/--*/-/g' | cut -c1-40; }
model_col() { local m="${model:--}"; [ -n "$effort" ] && m="$m/$effort"; printf '%s' "$m"; }   # "name/effort", "-" when unset

# ---------------------------------------------------------------- --continue, ledger side
if [ -n "$cont" ] && [ -z "$noledger" ]; then
  prompt="${1:-}"; [ -n "$prompt" ] || usage
  row="$(HATCH_NO_REAP=1 "$here/hatch-ledger" lookup "$cont" ${host:+"$host"})" || exit 1
  IFS=$'\t' read -r l_host l_agent l_session l_slug l_out l_round l_model _ <<<"$row"
  agent="${l_agent%/ro}"; case "$l_agent" in */ro) readonly=1 ;; esac
  round=$((l_round + 1)); slug="$l_slug"
  if [ -z "$model" ] && [ -z "$effort" ] && [ "$l_model" != - ]; then   # keep the task's model and effort unless overridden
    case "$l_model" in */*) effort="${l_model#*/}" ;; esac
    model="${l_model%%/*}"; [ "$model" = - ] && model=""
  fi
  [ -n "$expect" ] || expect="$(printf '%s' "$prompt" | tr '\n' ' ' | cut -c1-80)"
  cargs=(--no-ledger --continue "$l_session" --out "$l_out" --round "$round" --slug "$slug" --expect "$expect")
  [ -n "$readonly" ] && cargs+=(--readonly); [ -n "$force" ] && cargs+=(--force)
  [ -n "$model" ] && cargs+=(--model "$model"); [ -n "$effort" ] && cargs+=(--effort "$effort")
  if [ "$l_host" = local ]; then res="$("$0" "${cargs[@]}" "$agent" "$prompt")"; rc=$?
  else res="$(hatch_remote_cmd "$l_host" hatch-launch "${cargs[@]}" "$agent" "$prompt")"; rc=$?; fi
  [ -n "$res" ] && printf '%s\n' "$res"
  [ "$rc" -eq 0 ] || exit "$rc"
  HATCH_NO_REAP=1 "$here/hatch-ledger" add "$l_host" "$l_agent" "$l_session" "$slug" "$l_out" "$expect" "$round" "$(model_col)" >/dev/null 2>&1
  exit 0
fi

if [ -n "$cont" ]; then agent="${1:-}"; path=""; prompt="${2:-}"; else agent="${1:-}"; path="${2:-}"; prompt="${3:-}"; fi
case "$agent" in
claude) default_cmd=claude; default_prefix=claude-; cmd_override="${HATCH_CLAUDE_CMD:-}" ;;
codex)  default_cmd=codex;  default_prefix=codex-;  cmd_override="${HATCH_CODEX_CMD:-}" ;;
*) usage ;;
esac

# slug: from the start of the instructions if not given; drop characters tmux session names cannot hold
if [ -z "$slug" ]; then
  slug="$(sanitize "$(printf '%s' "$prompt" | tr -cd '[:alnum:] _-' | head -c 40)")"
  [ -n "$slug" ] || slug="task-$(date +%H%M%S)"
else
  slug="$(sanitize "$slug")"
fi
[ -n "$expect" ] || expect="$(printf '%s' "$prompt" | tr '\n' ' ' | cut -c1-80)"

# ---------------------------------------------------------------- --host: run remotely, write only the ledger here
# The calling shell expands ~ to the local home; map that back to ~ so the remote resolves its own home.
if [ -n "$host" ] && [ -z "$cont" ]; then
  case "$path" in "$HOME"/*) path="~${path#"$HOME"}" ;; "$HOME") path="~" ;; esac
  args=(--no-ledger --slug "$slug" --expect "$expect"); [ -n "$reuse" ] && args+=(--reuse); [ -n "$worktree" ] && args+=(--worktree)
  [ -n "$readonly" ] && args+=(--readonly); [ -n "$force" ] && args+=(--force); [ -n "$anydir" ] && args+=(--any-dir)
  [ -n "$branch" ] && args+=(--branch "$branch"); [ -n "$model" ] && args+=(--model "$model"); [ -n "$effort" ] && args+=(--effort "$effort")
  res="$(hatch_remote_cmd "$host" hatch-launch "${args[@]}" "$agent" "$path" "$prompt")" || { printf '%s\n' "$res"; exit 1; }
  printf '%s\n' "$res"
  line="$(printf '%s\n' "$res" | grep -m1 '^session=')"
  HATCH_NO_REAP=1 "$here/hatch-ledger" add "$host" "$agent${readonly:+/ro}" "$(sed 's/.*session=\([^ ]*\).*/\1/' <<<"$line")" "$slug" "$(sed 's/.*out=\([^ ]*\).*/\1/' <<<"$line")" "$expect" 1 "$(model_col)" >/dev/null 2>&1
  exit 0
fi

# ---------------------------------------------------------------- on the host where the agent runs
DIR="$(cd "$here/../../scripts" && pwd)"
# shellcheck source=../../scripts/helpers.sh
. "$DIR/helpers.sh"
prefix="$(agent_option "$agent" session_prefix "$default_prefix")"
cmd="${cmd_override:-$(agent_option "$agent" command "$default_cmd")}"   # HATCH_CLAUDE_CMD / HATCH_CODEX_CMD: stand-in agents for tests
args="$(agent_option "$agent" args '')"
me="$(hostname -s)"
mode=write; [ -n "$readonly" ] && mode=read

agent_flags() {   # per-launch flags; never the global tmux options
  local f=""
  case "$agent" in
  codex)  [ -n "$model" ] && f="$f -m $(printf '%q' "$model")"; [ -n "$effort" ] && f="$f -c model_reasoning_effort=$(printf '%q' "$effort")"
          # A writing Codex may write inside its working tree only; the report lives in the out directory, so
          # make that writable too (otherwise every report write stops at a permission prompt).
          if [ -n "$readonly" ]; then f="$f --sandbox read-only"
          elif [ -n "${out:-}" ]; then f="$f --add-dir $(printf '%q' "$out")"; fi ;;
  claude) [ -n "$model" ] && f="$f --model $(printf '%q' "$model")"; [ -n "$effort" ] && f="$f --effort $(printf '%q' "$effort")"
          [ -n "$readonly" ] && f="$f --permission-mode plan" ;;
  esac
  printf '%s' "$f"
}
report_name() { if [ "$1" -gt 1 ]; then printf 'report-%s.md' "$1"; else printf 'report.md'; fi; }
footer_for() {   # <round>
  local r="$1" rep; rep="$out/$(report_name "$1")"
  local task="Task id: ${slug}."; [ "$r" -gt 1 ] && task="Task id: ${slug}, round ${r} (a follow-up in this same session)."
  if [ -n "$readonly" ]; then
    printf '\n\n---\n[hatch] %s This is a read-only investigation/review: do not change files. Your final response is saved as the deliverable, so make it self-contained with the headings '"'## Summary', '## Findings' (cite file:line), '## Validation' (what you actually read or ran) and '## Handoff'"' (unverified points, next steps).' "$task"
  else
    local keep=""; [ "$r" -gt 1 ] && keep=" Leave the reports of earlier rounds untouched."
    printf '\n\n---\n[hatch] %s When the work is done you must write the results to %s with the headings '"'## Summary', '## Changed' (files changed), '## Validation' (checks you ran and their results) and '## Handoff'"' (unfinished work, next steps, anything needing confirmation).%s Write the report before ending your final response. If you stop at a question or an approval, write the current state to the report as well.' "$task" "$rep" "$keep"
  fi
}
# One writer per working tree (read-only sessions do not count). <dir> <session to ignore>
check_writer() {
  [ "$mode" = write ] && [ -z "$force" ] || return 0
  local s_ m_ p_
  for s_ in $(tmux list-sessions -F '#S' 2>/dev/null); do
    [ "$s_" = "$2" ] && continue
    m_="$(tmux show-options -t "$s_" -qv @hatch_mode 2>/dev/null)"; [ "$m_" = write ] || continue
    p_="$(tmux display-message -p -t "$s_" '#{pane_current_path}' 2>/dev/null)"
    [ "$p_" = "$1" ] || [ "$(tmux display-message -p -t "$s_" '#{session_path}' 2>/dev/null)" = "$1" ] || continue
    if [ "$(tmux show-options -t "$s_" -qv @hatch_closed 2>/dev/null)" = 1 ]; then
      echo "refused: writer session '$s_' is still alive in $1, but its task is already closed (it is in the grace period before being ended)." >&2
      echo "  to give that session a follow-up: hatch-launch --continue $s_ \"<instructions>\"; to free the directory now: hatch-end $s_" >&2
      echo "  otherwise --readonly (investigation/review), --worktree (implement in a separate tree), or --force" >&2
    else
      echo "refused: another writer session '$s_' is working in $1." >&2
      echo "  use --continue $s_ (a follow-up in that session), --readonly (investigation/review), --worktree (implement in a separate tree), or --force" >&2
    fi
    exit 3
  done
}
# A session created from a non-interactive client (ssh, OpenClaw's exec) inherits that client's minimal PATH,
# so set it explicitly. On failure, keep the pane for a minute so hatch-capture can show the error.
start_session() {   # <session> <dir> <command line>
  local launch_path="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.bun/bin:/opt/homebrew/bin:$PATH"
  local wrapped="export PATH=$(printf '%q' "$launch_path"); $3 || { rc=\$?; echo \"[hatch] $cmd exited with status \$rc\"; sleep 60; }"
  tmux new-session -d -s "$1" -c "$2" "$wrapped" || exit 1
}
mark_session() {   # <session> <round>
  tmux set-option -t "$1" detach-on-destroy on
  tmux set-option -t "$1" @hatch_openclaw 1
  tmux set-option -t "$1" @hatch_slug "$slug"
  tmux set-option -t "$1" @hatch_out "$out"
  tmux set-option -t "$1" @hatch_mode "$mode"
  tmux set-option -t "$1" @hatch_round "$2"
  tmux set-option -t "$1" @hatch_report "$(report_name "$2")"
  tmux set-option -t "$1" @hatch_model "$(model_col)"
  tmux set-option -t "$1" -u @hatch_closed 2>/dev/null
  tmux set-option -t "$1" -u @hatch_ending 2>/dev/null
  return 0
}

# ---------------------------------------------------------------- --continue, host side
if [ -n "$cont" ]; then
  session="$cont"
  [ -n "$out" ] && [ -f "$out/meta.json" ] || { echo "cannot continue $session: $out/meta.json is missing on $me" >&2; exit 1; }
  path="$(jq -r '.cwd // empty' "$out/meta.json")"
  [ -d "$path" ] || { echo "cannot continue $session: its directory $path no longer exists" >&2; exit 1; }
  check_writer "$path" "$session"
  full_prompt="${prompt}$(footer_for "$round")"
  if tmux has-session -t "=$session" 2>/dev/null; then
    mark_session "$session" "$round"
    "$here/hatch-send" "$session" "$full_prompt" || exit 1
    state=continued
  else
    aid="$(jq -r '.agent_session_id // empty' "$out/meta.json")"
    [ -n "$aid" ] || { echo "cannot resume $session: no agent_session_id in $out/meta.json (the agent never reported one)" >&2; exit 1; }
    case "$agent" in
    codex)  full="$cmd${args:+ $args} resume$(agent_flags) $(printf '%q' "$aid") $(printf '%q' "$full_prompt")" ;;
    claude) full="$cmd${args:+ $args}$(agent_flags) --resume $(printf '%q' "$aid") $(printf '%q' "$full_prompt")" ;;
    esac
    start_session "$session" "$path" "$full"
    mark_session "$session" "$round"
    state=resumed
  fi
  jq --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg e "$expect" --arg p "$prompt" --argjson r "$round" --arg m "$model" --arg ef "$effort" --arg st "$state" \
     '.status = "running" | del(.ended) | .round = $r | .rounds = ((.rounds // []) + [{round: $r, started: $t, expect: $e, prompt: $p, how: $st}])
      | (if $m != "" then .model = $m else . end) | (if $ef != "" then .effort = $ef else . end)' "$out/meta.json" >"$out/meta.json.tmp" 2>/dev/null \
    && mv -f "$out/meta.json.tmp" "$out/meta.json"
  echo "session=$session state=$state slug=$slug round=$round mode=$mode out=$out report=$out/$(report_name "$round") host=$me"
  exit 0
fi

# ---------------------------------------------------------------- a new task
path="${path/#\~/$HOME}"
[ -d "$path" ] || { echo "no such directory: $path" >&2; exit 1; }
path="$(cd "$path" && pwd -P)"
# Directory check: work happens inside a git repository. Never launch from a parent holding several repositories
# (such as ~/Git). --any-dir only when running outside a repository is really intended.
if [ -z "$anydir" ]; then
  if ! root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)"; then
    subs="$(find "$path" -mindepth 2 -maxdepth 2 -name .git 2>/dev/null | sed 's|/\.git$||' | head -5)"
    if [ -n "$subs" ]; then
      echo "refused: $path is not a repository but contains repositories. Launch inside one of them:" >&2
      printf '  %s\n' $subs >&2
    else
      echo "refused: $path is not inside a git repository. Use the repository directory, or --any-dir to launch here anyway." >&2
    fi
    exit 3
  fi
  [ "$root" = "$path" ] || echo "note: $path is inside repository $root (launching in the subdirectory as asked)" >&2
fi

# --reuse: hatch's own popup session for the dir
if [ -n "$reuse" ]; then
  old="${prefix}$(session_hash "$path")"
  if tmux has-session -t "=$old" 2>/dev/null; then
    [ -n "$prompt" ] && "$here/hatch-send" "$old" "$prompt"
    echo "session=$old state=reused slug=$slug round=1 mode=$mode out=$(tmux show-options -t "$old" -qv @hatch_out) host=$me"
    exit 0
  fi
fi

# --worktree: the same place and rules as hatch's own prefix+W (scripts/worktree.sh), so either side finds
# a worktree the other made: @hatch_worktree_dir/<branch>, defaulting to <repo>-wt/<branch> next to the repository.
if [ -n "$worktree" ]; then
  root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repo: $path" >&2; exit 1; }
  branch="${branch:-$slug}"
  case "$branch" in -* | *..* | *' '*) echo "bad branch name: $branch" >&2; exit 2 ;; esac
  wt="$(worktree_path "$root" "$branch")"
  if [ ! -d "$wt" ]; then
    mkdir -p "$(dirname "$wt")" 2>/dev/null
    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
      wt_out="$(git -C "$root" worktree add "$wt" "$branch" 2>&1)"
    else
      wt_out="$(git -C "$root" worktree add -b "$branch" "$wt" 2>&1)"
    fi
    [ -d "$wt" ] || { echo "git worktree add failed: ${wt_out##*$'\n'}" >&2; exit 1; }
  fi
  path="$wt"
fi

check_writer "$path" ""

# Deliverables directory (the out/ contract)
out="${HATCH_OUT_ROOT:-$HOME/.agents/out}/$(date +%Y%m%d-%H%M%S)-$slug"
mkdir -p "$out"

# Session name: <prefix><slug>; -2, -3 ... on collision
session="${prefix}${slug}"; n=1
while tmux has-session -t "=$session" 2>/dev/null; do n=$((n+1)); session="${prefix}${slug}-$n"; done

full_prompt="${prompt}$(footer_for 1)"
jq -n --arg slug "$slug" --arg agent "$agent" --arg session "$session" --arg cwd "$path" --arg host "$me" \
      --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg expect "$expect" --arg prompt "$prompt" --arg mode "$mode" \
      --arg model "$model" --arg effort "$effort" \
      '{slug:$slug, agent:$agent, session:$session, cwd:$cwd, host:$host, mode:$mode, model:$model, effort:$effort, started:$started,
        expect:$expect, prompt:$prompt, status:"running", round:1, rounds:[{round:1, started:$started, expect:$expect, prompt:$prompt, how:"created"}]}' \
      >"$out/meta.json" 2>/dev/null

start_session "$session" "$path" "$cmd${args:+ $args}$(agent_flags) $(printf '%q' "$full_prompt")"
mark_session "$session" 1
echo "session=$session state=created slug=$slug round=1 mode=$mode out=$out host=$me"
[ -n "$noledger" ] || HATCH_NO_REAP=1 "$here/hatch-ledger" add local "$agent${readonly:+/ro}" "$session" "$slug" "$out" "$expect" 1 "$(model_col)" >/dev/null 2>&1 || true
[ -n "$noledger" ] || HATCH_NO_REAP=1 hatch_detach "$here/hatch-reap"   # end sessions of closed tasks
exit 0
