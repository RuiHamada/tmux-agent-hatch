#!/usr/bin/env bash
# Ledger of delegated tasks (~/.openclaw/hatch-ledger.tsv). Tracked in a file, not in OpenClaw's memory.
# One row per round of a task; a session's state is the state of its latest row.
#   hatch-ledger list [--all]            open tasks (--all includes closed ones and whether the session is alive)
#   hatch-ledger show <session|slug>     the latest round of one task (and how many rounds it has had)
#   hatch-ledger close <session|slug> [note]   mark done and verified. A read-only session is ended before this
#                                              returns; a writer session after the grace period (see hatch-reap)
#   hatch-ledger note <session|slug> <text>    append a note (status unchanged)
#   hatch-ledger status <session> [host]       print open | closed | none (used by hatch-end)
#   hatch-ledger lookup <session|slug> [host]  latest row as TSV: host agent session slug out round model status
#   hatch-ledger add <host> <agent> <session> <slug> <out> <expect> [round] [model]   (called by hatch-launch)
# Columns: started host agent session slug out status expect note closed_at(epoch) round model
set -uo pipefail
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
HATCH_NO_DISPATCH=1 . "$here/_remote.sh"
LEDGER="${HATCH_LEDGER:-$HOME/.openclaw/hatch-ledger.tsv}"
HEADER='started\thost\tagent\tsession\tslug\tout\tstatus\texpect\tnote\tclosed_at\tround\tmodel\n'
mkdir -p "$(dirname "$LEDGER")"; [ -f "$LEDGER" ] || printf "$HEADER" >"$LEDGER"

# Serialize writers: several hatch commands may run at once (parallel exec calls, background reaps).
lock() { local i=0; until mkdir "$LEDGER.lock" 2>/dev/null; do i=$((i+1)); [ "$i" -gt 100 ] && { rm -rf "$LEDGER.lock"; continue; }; sleep 0.05; done; }
unlock() { rmdir "$LEDGER.lock" 2>/dev/null; }
rewrite() {   # rewrite <awk-args...>: run awk over the ledger and replace it atomically; awk exit status is returned
  lock; local rc
  awk -F'\t' -v OFS='\t' "$@" "$LEDGER" >"$LEDGER.tmp"; rc=$?
  if [ "$rc" -eq 0 ]; then mv -f "$LEDGER.tmp" "$LEDGER"; else rm -f "$LEDGER.tmp"; fi
  unlock; return "$rc"
}
# Older ledgers lack the newer columns: rewrite the header only (rows keep empty values).
if ! head -1 "$LEDGER" | grep -q 'round'; then
  lock; { printf "$HEADER"; tail -n +2 "$LEDGER"; } >"$LEDGER.tmp" && mv -f "$LEDGER.tmp" "$LEDGER"; unlock
fi
cmd="${1:-list}"; shift || true
clean() { printf '%s' "$1" | tr '\t\n' '  '; }
reap_bg() { [ -n "${HATCH_NO_REAP:-}" ] || HATCH_NO_REAP=1 hatch_detach "$here/hatch-reap"; }
case "$cmd" in
add)
  [ $# -ge 6 ] || { echo "usage: hatch-ledger add <host> <agent> <session> <slug> <out> <expect> [round] [model]" >&2; exit 2; }
  round="${7:-1}"; model="$(clean "${8:-}")"
  # A new round supersedes earlier rows of the same session that were left open.
  rewrite -v h="$(clean "$1")" -v s="$(clean "$3")" -v r="$round" -v now="$(date +%s)" -v d="$(date '+%m-%d %H:%M')" '
    NR > 1 && $2 == h && $4 == s && $7 == "open" { $7 = "closed"; $10 = now; $9 = ($9 == "" ? "" : $9 "; ") d " superseded by round " r } { print }'
  lock
  printf '%s\t%s\t%s\t%s\t%s\t%s\topen\t%s\t\t\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M)" "$(clean "$1")" "$(clean "$2")" "$(clean "$3")" "$(clean "$4")" "$(clean "$5")" "$(clean "$6")" "$round" "$model" >>"$LEDGER"
  unlock ;;
list)
  all=""; [ "${1:-}" = --all ] && all=1
  alive=""
  if [ -n "$all" ]; then
    . "$here/_alive.sh"; alive="$(hatch_alive_pairs "$LEDGER" | paste -sd"|" -)"   # one line: BSD awk rejects newlines in -v
  fi
  awk -F'\t' -v all="$all" -v now="$(date +%s)" -v alive="$alive" '
    BEGIN { n = split(alive, a, "|"); for (i = 1; i <= n; i++) up[a[i]] = 1 }
    NR==1 { print "age\thost\tagent\tsession\tslug\tround\tstatus\t" (all ? "alive\t" : "") "model\texpect\tnote"; next }
    all || $7 == "open" {
      cmd = "date -j -f %Y-%m-%dT%H:%M " $1 " +%s 2>/dev/null || date -d " $1 " +%s 2>/dev/null"; cmd | getline t; close(cmd)
      m = int((now - t) / 60); age = (m < 60) ? m "m" : int(m / 60) "h"
      print age "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" ($11 == "" ? 1 : $11) "\t" $7 "\t" (all ? ((($2 "/" $4) in up) ? "yes" : "no") "\t" : "") ($12 == "" ? "-" : $12) "\t" $8 "\t" $9 }' "$LEDGER"
  reap_bg ;;
show)
  key="${1:-}"; [ -n "$key" ] || { echo "usage: hatch-ledger show <session|slug>" >&2; exit 2; }
  awk -F'\t' -v k="$key" 'NR > 1 && ($4 == k || $5 == k) { n++; row = $0 }
    END { if (!n) exit 1; split(row, f, "\t")
      printf "started=%s\nhost=%s\nagent=%s\nsession=%s\nslug=%s\nround=%s (of %d)\nmodel=%s\nout=%s\nstatus=%s\nexpect=%s\nnote=%s\n", f[1],f[2],f[3],f[4],f[5],(f[11]==""?1:f[11]),n,(f[12]==""?"-":f[12]),f[6],f[7],f[8],f[9] }' "$LEDGER" || { echo "not in ledger: $key" >&2; exit 1; } ;;
lookup)
  key="${1:-}"; host="${2:-}"; [ -n "$key" ] || { echo "usage: hatch-ledger lookup <session|slug> [host]" >&2; exit 2; }
  awk -F'\t' -v OFS='\t' -v k="$key" -v h="$host" 'NR > 1 && ($4 == k || $5 == k) && (h == "" || $2 == h) { row = $0; f = 1 }
    END { if (!f) exit 1; split(row, c, "\t"); print c[2], c[3], c[4], c[5], c[6], (c[11]==""?1:c[11]), (c[12]==""?"-":c[12]), c[7] }' "$LEDGER" || { echo "not in ledger: $key" >&2; exit 1; } ;;
status)
  key="${1:-}"; host="${2:-}"; [ -n "$key" ] || { echo "usage: hatch-ledger status <session> [host]" >&2; exit 2; }
  awk -F'\t' -v k="$key" -v h="$host" 'NR > 1 && $4 == k && (h == "" || $2 == h) { s = $7 } END { print (s == "" ? "none" : s) }' "$LEDGER" ;;
close|note)
  key="${1:-}"; text="$(clean "${2:-}")"; [ -n "$key" ] || { echo "usage: hatch-ledger $cmd <session|slug> [text]" >&2; exit 2; }
  rewrite -v k="$key" -v c="$cmd" -v t="$text" -v d="$(date '+%m-%d %H:%M')" -v now="$(date +%s)" '
    NR > 1 && ($4 == k || $5 == k) {
      # close acts on open rows; a note goes to the latest row only (handled by remembering the last match)
      if (c == "close" && $7 == "open") { $7 = "closed"; $10 = now; if (t != "") $9 = ($9 == "" ? "" : $9 "; ") d " " t }
      last = NR; f = 1 }
    { line[NR] = $0 }
    END { if (!f) exit 1
      if (c == "note" && t != "") { split(line[last], x, "\t"); x[9] = (x[9] == "" ? "" : x[9] "; ") d " " t
        s = x[1]; for (i = 2; i <= 12; i++) s = s "\t" x[i]; line[last] = s }
      for (i = 1; i <= NR; i++) print line[i] }' || { echo "not in ledger: $key" >&2; exit 1; }
  echo "$cmd: $key"
  if [ "$cmd" = close ] && [ -z "${HATCH_NO_END:-}" ]; then
    # Act on the session of the latest matching row, in the foreground: background work does not survive
    # callers that kill their process group when the command returns.
    if row="$("$0" lookup "$key" 2>/dev/null)"; then
      IFS=$'\t' read -r r_host r_agent r_session _ <<<"$row"
      hostargs=(); [ "$r_host" = local ] || hostargs=(--host "$r_host")
      case "$r_agent" in
      */ro)
        if out="$(HATCH_NO_REAP=1 "$here/hatch-end" ${hostargs[@]+"${hostargs[@]}"} "$r_session" 2>&1)"; then echo "$out"
        else case "$out" in *"no such session"*) echo "session already gone: $r_session" ;; *) echo "could not end $r_session: $out" >&2 ;; esac; fi ;;
      *)
        # Writer: mark the live session as closed (hatch-notify stays silent for it; hatch-launch explains it
        # when it blocks another writer). It is ended after the grace period by hatch-reap.
        if [ "$r_host" = local ]; then tmux set-option -t "$r_session" @hatch_closed 1 2>/dev/null
        else hatch_remote_cmd "$r_host" tmux set-option -t "$r_session" @hatch_closed 1 2>/dev/null; fi
        echo "writer session $r_session stays for the grace period (hatch-end $r_session ends it now; hatch-launch --continue $r_session reopens it)" ;;
      esac
    fi
    reap_bg
  fi ;;
*) echo "usage: hatch-ledger list [--all] | show <k> | close <k> [note] | note <k> <text> | status <session> [host] | lookup <k> [host]" >&2; exit 2 ;;
esac
exit 0
