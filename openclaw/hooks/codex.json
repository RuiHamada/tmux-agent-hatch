{
  "hooks": {
    "PreToolUse":        [ { "matcher": "^request_user_input_async$", "hooks": [ { "type": "command", "command": "bash \"__OC_DIR__/bin/hatch-notify\"" } ] } ],
    "PermissionRequest": [ { "hooks": [ { "type": "command", "command": "bash \"__OC_DIR__/bin/hatch-notify\"" } ] } ],
    "Stop":              [ { "hooks": [ { "type": "command", "command": "bash \"__OC_DIR__/bin/hatch-notify\"" } ] } ],
    "SessionEnd":        [ { "hooks": [ { "type": "command", "command": "bash \"__OC_DIR__/bin/hatch-notify\"" } ] } ]
  }
}
